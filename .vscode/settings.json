{
  "files.exclude": {
    "**/.git": true,
  },
  // replaces the user-level nixd block, so formatting is repeated here
  "nix.serverSettings": {
    "nixd": {
      "formatting": { "command": ["nixfmt"] },
      "nixpkgs": {
        "expr": "import (builtins.getFlake (builtins.toString ./.)).inputs.nixpkgs { }"
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.laptop.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.laptop.options.home-manager.users.type.getSubOptions [ ]"
        }
      }
    }
  },
  "cSpell.words": [
    "agenix",
    "alsa",
    "attrset",
    "bryton",
    "csshacks",
    "ddccontrol",
    "disko",
    "elif",
    "kubie",
    "libinput",
    "luks",
    "nextcloud",
    "nixos",
    "nixpkgs",
    "NOPASSWD",
    "optimise",
    "pipewire",
    "pkgs",
    "polkit",
    "Pubkey",
    "rtkit",
    "screencast",
    "stdenv",
    "stylix",
    "swaylock",
    "syncthing",
    "touchpad",
    "tridactyl",
    "udevmon",
    "upower",
    "virtualisation",
    "wireplumber"
  ]
}